# --- Existentes (no tocar) ---
SHOPIFY_SECRET=
ENVIA_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
WHATSAPP_TEMPLATE_SID=
ZOHO_EMAIL=
ZOHO_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Nuevos: WhatsApp Cloud API (Meta) + IA ---
# App Secret de la app de Meta (App Settings > Basic). Se usa para verificar
# la firma X-Hub-Signature-256 de los webhooks.
META_APP_SECRET=

# Token permanente del System User (Business Settings > Users > System users).
# Permisos: whatsapp_business_messaging, whatsapp_business_management, business_management
META_ACCESS_TOKEN=

# Phone Number ID (WhatsApp > API Setup)
META_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID)
META_WABA_ID=

# Verify token que configuras en Meta > Webhooks. Generalo con:
#   openssl rand -hex 24
META_VERIFY_TOKEN=

# Version de Graph API a usar
META_GRAPH_VERSION=v23.0

# Instagram Account ID (IGSID). Opcional: si se define, el envio usa
# /{IG_ACCOUNT_ID}/messages; si no, usa /me/messages.
META_INSTAGRAM_ACCOUNT_ID=

# API key de x.ai (https://console.x.ai/team/default/api-keys)
XAI_API_KEY=

# Modelo de x.ai a usar
XAI_MODEL=grok-4.7
