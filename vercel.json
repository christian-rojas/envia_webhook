{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/bandeja",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/klaviyo-purge",
      "schedule": "0 14 * * *"
    }
  ]
}